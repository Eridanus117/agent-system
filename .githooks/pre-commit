#!/bin/sh
# 本地先跑 skill 仓储检查：目录结构合法、目录页 skills-overview.md 与源一致。
# 改了 plugins/*/skills/*/SKILL.md 没重生成目录页，就在这里被拦，不用等 CI。
if ! node plugins/tests/skills.test.ts >/dev/null 2>&1; then
  echo "pre-commit 拦截：skill 仓储结构或目录页不一致。先跑："
  echo "  node plugins/scripts/skills-overview.ts --write"
  echo "然后 git add 生成物再提交。详情：node plugins/tests/skills.test.ts"
  exit 1
fi
